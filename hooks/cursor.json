{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node \"./bin/agent-lcm\" capture --harness cursor sessionStart"
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "node \"./bin/agent-lcm\" capture --harness cursor beforeSubmitPrompt"
      }
    ],
    "postToolUse": [
      {
        "command": "node \"./bin/agent-lcm\" capture --harness cursor postToolUse"
      }
    ],
    "stop": [
      {
        "command": "node \"./bin/agent-lcm\" capture --harness cursor stop"
      }
    ]
  }
}
