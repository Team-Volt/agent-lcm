{
  "version": 1,
  "hooks": {
    "sessionStart": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/bin/agent-lcm\" capture --harness copilot sessionStart" }],
    "userPromptSubmitted": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/bin/agent-lcm\" capture --harness copilot userPromptSubmitted" }],
    "postToolUse": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/bin/agent-lcm\" capture --harness copilot postToolUse" }],
    "agentStop": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/bin/agent-lcm\" capture --harness copilot agentStop" }]
  }
}
